# Setu API — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env with real credentials.

NODE_ENV=development
PORT=3001

# MongoDB Atlas connection string (required for persistence/analytics — not needed for scaffold health check)
MONGODB_URI=

# Gemini API key — used ONLY for bounded classification/rephrasing. NOT for fallback decisions.
GEMINI_API_KEY=

# Bhashini REST API credentials (P1 — not required for scaffold)
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# HMAC_SECRET — used for server-generated pseudonymous references only if beneficiary-level
# correlation is determined to be necessary. Raw identifiers are discarded immediately.
# Leave blank if not needed.
HMAC_SECRET=
