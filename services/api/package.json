{
  "name": "@setu/api",
  "version": "0.1.0",
  "private": true,
  "description": "Setu Express API service",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
