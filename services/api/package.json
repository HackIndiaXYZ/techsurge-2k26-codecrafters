  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "helmet": "^8.0.0",
    "mongoose": "^9.10.1",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
